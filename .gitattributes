# Auto-detect text files and perform LF normalization
* text=auto

# GDScript files should always use LF
*.gd text eol=lf

# Godot resource and scene files should always use LF
*.tres text eol=lf
*.tscn text eol=lf

# Markdown files should use LF
*.md text eol=lf

# Image files are binary
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary

# Other text files
*.txt text eol=lf
*.json text eol=lf
*.cfg text eol=lf
